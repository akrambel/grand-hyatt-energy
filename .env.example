# Copy to .env for local development (git-ignored). For GitHub Pages these are set as repository
# VARIABLES (Settings > Secrets and variables > Actions > Variables) – see README.
#
# The anon key is PUBLIC by design (it ships inside the website). All data is protected by
# Row Level Security + user login. NEVER put the service_role key in this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Usernames are converted to <username>@<domain> for Supabase Auth. Must match AUTH_EMAIL_DOMAIN used by seed:users.
VITE_AUTH_EMAIL_DOMAIN=energy.ghrs.app
# Optional branding overrides
VITE_APP_NAME=Energy & Utilities Management Dashboard
VITE_PROPERTY_NAME=Grand Hyatt The Red Sea
# Path of the logo inside /public (default brand/logo.png; replace that file with another logo of your own if needed)
VITE_LOGO_PATH=brand/logo.png
