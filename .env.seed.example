# Copy to .env.seed (git-ignored) and fill in. Used ONLY by `npm run seed:users` on your own computer.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase dashboard > Project Settings > API > "service_role" key. SECRET – never commit or share it.
SUPABASE_SERVICE_ROLE_KEY=
# Must match VITE_AUTH_EMAIL_DOMAIN in .env (usernames are turned into <username>@<domain>)
AUTH_EMAIL_DOMAIN=energy.ghrs.app

# Username:role:can_enter_data  (role = admin | user). Admins can always enter data.
SEED_USERS=Akram:admin:true,Abdessamad:user:false,Arvind:user:false

# One password per user: SEED_PASSWORD_<USERNAME IN CAPITALS>. Min 10 chars, 3 of 4 character classes.
SEED_PASSWORD_AKRAM=
SEED_PASSWORD_ABDESSAMAD=
SEED_PASSWORD_ARVIND=
